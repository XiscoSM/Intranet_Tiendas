@page
@model IndexModel
@{
    ViewData["Title"] = "Intranet Tiendas";
}

@if (Model.ComunicadosPendientes > 0)
{
    <a class="aviso" href="/Comunicados">
        <img src="~/img/mail.jpg" width="25" height="25" alt="Comunicados" />
        Tiene @Model.ComunicadosPendientes comunicados pendientes de leer
    </a>
}

