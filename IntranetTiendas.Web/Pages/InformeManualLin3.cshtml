@page
@model InformeManualLin3Model
@{
    ViewData["Title"] = "Informe Detalle";
}

<table align="right">
    <tr>
        <td class="export-bar" onclick="ExportPage()"><img src="~/img/excel.jpg" width="23" height="23" alt="Excel" /></td>
        <td>
            <div align="right" class="info_pequeno">
                @Model.Empresa - Alm: @Model.Alm - @DateTime.Now.ToString("dd/MM/yyyy HH:mm")
            </div>
        </td>
    </tr>
</table>

<p align="center" class="Titulos">Informe @Model.Text  - @Model.P2  Nº:@Model.P3 en desarrollo </p>
<table width="98%" border="1" align="center" class="datos">
    <tr class="CabeceraTablas">
        <td width="10%" nowrap class="normal"><div>Prod</div></td>
        <td width="10%" nowrap class="normal"><div><b>Ean</b></div></td>
        <td width="50%" nowrap class="normal"><div><b>Descripcion</b></div></td>
        <td width="5%" nowrap class="normal"><div><b>Stock</b></div></td>
        <td width="5%" nowrap class="normal"><div align="center">Compra</div></td>
        <td width="5%" nowrap class="normal">Ref.Prov</td>
        <td width="5%" nowrap class="normal"><div><b>Pvp</b></div></td>
        <td width="5%" nowrap class="normal"><div><b>Oferta</b></div></td>
        <td width="5%" nowrap class="normal"><div><b>Pvp</b> Nuevo</div></td>
    </tr>
    @foreach (var r in Model.Lineas)
    {
        var d = (IDictionary<string, object>)r;
        <tr bgcolor="#FFFFFF" class="tablamediano">
            <td width="10%" nowrap>
                <div align="left"><a href="/Producto?P1=@d["Prod"]">@d["Prod"] &gt;&gt;</a></div>
            </td>
            <td width="10%" nowrap><div align="left">@d["Ean"]</div></td>
            <td width="50%" nowrap><div align="left">@d["DescProdCompleta"]</div></td>
            <td width="5%" nowrap><div align="right"> @Model.Numero(d["ValorA"])</div></td>
            <td width="5%" nowrap><div align="center">@d["ValorB"]</div></td>
            <td width="5%" nowrap>@d["ValorC"]</td>
            <td width="5%" nowrap><div align="right">@Model.Moneda(d["PrecioB"])</div></td>
            <td width="5%" nowrap>
                <div align="right">
                    @if (Convert.ToDecimal(d["PrecioC"] ?? 0) > 0)
                    {
                        @Model.Moneda(d["PrecioC"])
                    }
                </div>
            </td>
            <td width="5%" nowrap><div align="right">@Model.Moneda(d["PrecioA"])</div></td>
        </tr>
    }
</table>
<table width="100%" height="5" border="0">
    <tr>
        <td><div align="left"><a href="javascript:history.back();">Volver </a></div></td>
        <td><div align="right" class="Negrita">Importe Venta: @Model.Moneda(Model.Total)</div></td>
    </tr>
</table>
