@page
@model LoginModel
@{
    ViewData["Title"] = "Acceso - Intranet Tiendas";
    Layout = "_Layout";
}
<div class="login-box">
    <img src="~/img/logo_hipercentro.svg" alt="Hipercentro" class="login-logo" />
    <form method="post">
        <label class="normal" for="Usuario">Usuario</label>
        <input type="text" inputmode="numeric" asp-for="Usuario" data-enter-next="#Password" autofocus autocomplete="username" />
        <label class="normal" for="Password">Contraseña</label>
        <input type="password" inputmode="numeric" asp-for="Password" autocomplete="current-password" />
        @if (!string.IsNullOrEmpty(Model.Error))
        {
            <p class="error">@Model.Error</p>
        }
        <input type="submit" value="Entrar" />
    </form>
</div>
