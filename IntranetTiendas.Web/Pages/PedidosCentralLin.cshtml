@page
@model PedidosCentralLinModel
@{
    ViewData["Title"] = "Pedido Central Detalle";
}

<div align="right">
    <div id="CapaFiltros" style="display:none;">
        <table width="90%" height="20">
            <tr>
                <td class="tablamediano">
                    <form action="/PedidosCentralLin" method="get" name="form2" target="_parent">
                        <div align="right">
                            <input name="P2" type="hidden" id="P2" value="@Model.P2" size="9" maxlength="9" />
                            <input name="P3" type="hidden" id="P3" value="@Model.P3" size="3" maxlength="3" />
                            No Preparado:
                            <input type="checkbox" name="P4" value="3" />
                            <input name="Filtrar" type="submit" value="Filtrar" />
                        </div>
                    </form>
                </td>
                <td class="Titulos" onclick="toggle('CapaFiltros')">Ocultar Filtros</td>
            </tr>
        </table>
    </div>

    <table width="100%">
        <tr>
            <td width="90%"></td>
            <td onclick="toggle('CapaFiltros')"><img src="~/img/FILTRO.jpg" width="23" height="23" alt="Filtros" /></td>
            <td class="export-bar" onclick="ExportPage()"><img src="~/img/excel.jpg" width="23" height="23" alt="Excel" /></td>
            <td width="60%">
                <div align="right">
                    <span class="info_pequeno">@Model.Empresa - Alm: @Model.Alm - @DateTime.Now.ToString("dd/MM/yyyy HH:mm")</span>
                </div>
            </td>
        </tr>
    </table>

    <p align="center" class="Titulos">
        Pedido @Model.P3 - @Model.P2 - Central
        @if (Model.Filtro < 3)
        {
            <a href="/PedidosCentralLin?P2=@Model.P2&P3=@Model.P3&P4=3">(FILTRAR)</a>
        }
        else
        {
            <a href="/PedidosCentralLin?P2=@Model.P2&P3=@Model.P3&P4=0">(Quitar Filtros)</a>
        }
    </p>

    <table width="98%" align="center" class="datos">
        <tr class="CabeceraTablas">
            <td width="10%" nowrap class="normal"><div>Prod</div></td>
            <td width="10%" nowrap class="normal"><div><b>Ean</b></div></td>
            <td width="5%" class="normal">F.Col</td>
            <td width="50%" nowrap class="normal"><div><b>Descripcion</b></div></td>
            <td width="5%" nowrap class="normal"><div>U/C</div></td>
            <td width="5%" nowrap class="normal"><div><b>Cajas</b></div></td>
            <td width="5%" nowrap class="normal"><div><b>Cant</b></div></td>
            <td width="5%" nowrap class="normal"><div><b>Cajas</b> Env </div></td>
            <td width="5%" nowrap class="normal"><div><b>Cant</b> Env </div></td>
        </tr>
        @foreach (var r in Model.Lineas)
        {
            var d = (IDictionary<string, object>)r;
            var cajasPedidas = Convert.ToDecimal(d["CajasPedidas"]);
            var cajasEnviadas = Convert.ToDecimal(d["CajasEnviadas"]);
            var cantEnviada = Convert.ToDecimal(d["CantEnviada"]);

            if (cajasPedidas != cajasEnviadas || Model.Filtro < 2)
            {
                var claseFila = cajasPedidas == cajasEnviadas ? "tablamediano"
                              : cajasPedidas > cajasEnviadas ? "tablaMedianoRojo"
                              : "tablaMedianoAzul";
                <tr class="@claseFila">
                    <td width="10%" nowrap>
                        <div align="left"><a href="/Producto?P1=@d["Prod"]">@d["Prod"] &gt;&gt;</a></div>
                    </td>
                    <td width="10%" nowrap><div align="left">@d["Ean"]</div></td>
                    <td>
                        <div align="center">
                            @if (d["FueraColeccion"] is bool fc && fc)
                            {
                                <text>X</text>
                            }
                        </div>
                    </td>
                    <td width="50%" nowrap><div align="left">@d["DescProdCompleta"]</div></td>
                    <td width="5%" nowrap><div align="right">@d["UnidsCaja"]</div></td>
                    <td width="5%" nowrap><div align="right">@d["CajasPedidas"]</div></td>
                    <td width="5%" nowrap><div align="right">@d["CantPedida"]</div></td>
                    <td width="5%" nowrap>
                        <div align="right">@if (cantEnviada > 0) { @d["CajasEnviadas"] }</div>
                    </td>
                    <td width="5%" nowrap>
                        <div align="right">@if (cantEnviada > 0) { @d["CantEnviada"] }</div>
                    </td>
                </tr>
            }
        }
    </table>
    <table width="100%" height="5" border="0">
        <tr>
            <td><a href="javascript:history.back();">Volver</a></td>
        </tr>
    </table>
</div>
